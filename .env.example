# PMOVES-Health-wger - PMOVES Branded Defaults
# Source: pmoves/env.shared in parent PMOVES.AI repo
# Dual-mode: standalone (fork) or docked (PMOVES.AI integration)

# =============================================================================
# IMAGE CONFIGURATION
# =============================================================================
# Docker image to use
WGER_IMAGE=ghcr.io/powerfulmoves/pmoves-health-wger:pmoves-latest

# Nginx image (when using --profile nginx)
WGER_NGINX_IMAGE=nginx:1.27-alpine

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# Container name
CONTAINER_NAME=pmoves-wger

# Nginx container name (when using --profile nginx)
NGINX_CONTAINER_NAME=pmoves-wger-nginx

# Database container name (when using PostgreSQL)
DB_CONTAINER_NAME=pmoves-wger-db

# Network name for standalone mode
NETWORK_NAME=pmoves_app

# Parent data network (when docked to PMOVES.AI)
PARENT_DATA_NETWORK=pmoves_data

# Volume prefix for named volumes
VOLUME_PREFIX=wger

# =============================================================================
# PORTS & URLS
# =============================================================================
# Web UI port (direct Django)
# - Standalone: 8000 (default, may conflict with Open Notebook if PMOVES.AI running)
# - Docked: Parent uses WGER_HOST_PORT via docker-compose.external.yml
# - Override if port is already in use on your host
WGER_PORT=8000

# Nginx frontend port (when using --profile nginx)
WGER_NGINX_PORT=80

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# Debug mode (set to False in production)
DJANGO_DEBUG=False

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use gunicorn (recommended for production)
WGER_USE_GUNICORN=True

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database engine: sqlite3 (default) or postgres
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/home/wger/db.sqlite3

# PostgreSQL configuration (when using --profile postgres)
POSTGRES_DB=wger
POSTGRES_USER=wger
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# =============================================================================
# WGER SETTINGS
# =============================================================================
# Site configuration
SITE_URL=http://localhost:8000
EMAIL_FROM=wger@pmoves.ai

# Timezone
TZ=UTC

# =============================================================================
# PMOVES INTEGRATION
# =============================================================================
# Mode: standalone or docked
# - standalone: Runs independently with local configuration
# - docked: Connects to PMOVES.AI infrastructure (requires parent network)
PMOVES_MODE=standalone

# =============================================================================
# PMOVES BRANDED DEFAULTS - Application Credentials
# =============================================================================
# Default admin credentials (use create-admin to create)
# PMOVES standard: pmoves@pmoves.ai for ALL services
WGER_ADMIN_EMAIL=pmoves@pmoves.ai
WGER_ADMIN_USERNAME=pmoves
WGER_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# =============================================================================
# NOTES
# =============================================================================
# - First run: migrate and load data
#   make db-migrate
#   make db-load-data
#   make create-admin
# - For production, use PostgreSQL profile: make up-postgres
# - For production, use nginx frontend: make up-nginx
# - When docked to PMOVES.AI, set PMOVES_MODE=docked
# - Backup data regularly (media and static volumes)

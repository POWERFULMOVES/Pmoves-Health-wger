# PMOVES-Health-wger - Local Overrides (.env.local)
# This file contains sensitive/secret values and should NOT be committed
# Copy from .env.local.example and customize for your environment

# =============================================================================
# SECRETS - CHANGE THESE IN PRODUCTION!
# =============================================================================

# Django secret key
# Run: openssl rand -base64 32
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# PostgreSQL password (when using PostgreSQL profile)
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Admin credentials (use create-admin for interactive setup)
WGER_ADMIN_EMAIL=admin@pmoves.ai
WGER_ADMIN_USERNAME=admin
WGER_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Email configuration (optional, for password resets)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# =============================================================================
# LOCAL OVERRIDES
# =============================================================================

# Override any values from .env here for local development
# Example:
# DJANGO_DEBUG=True
